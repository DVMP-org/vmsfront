{
  "name": "@vms/vmsfront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --bun next dev --turbo",
    "dev:webpack": "next dev",
    "dev:workspace": "turbo run dev --parallel",
    "build": "next build",
    "build:apps": "turbo run build --filter='./apps/*'",
    "start": "next start -p ${PORT:-3000}",
    "gcp-build": "node --max_old_space_size=8192 node_modules/.bin/next build",
    "lint": "next lint",
    "lint:apps": "turbo run lint --filter='./apps/*'",
    "typecheck:app": "tsc --noEmit",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workspace": "turbo run test",
    "test:e2e": "pnpm --dir playwright test",
    "test:e2e:ui": "pnpm --dir playwright test:ui",
    "test:e2e:headed": "pnpm --dir playwright test:headed",
    "test:e2e:debug": "pnpm --dir playwright test:debug",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "verify": "pnpm lint && node scripts/check-package-boundaries.mjs && pnpm typecheck:app && pnpm typecheck && pnpm test && pnpm build && pnpm build:apps"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@next/bundle-analyzer": "^14.2.0",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.28.0",
    "@types/react-datepicker": "^7.0.0",
    "@uiw/react-md-editor": "^3.25.6",
    "@vms/api-client": "workspace:*",
    "@vms/ui": "workspace:*",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "faker": "^6.6.6",
    "framer-motion": "^12.26.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.363.0",
    "next": "^15.5.28",
    "qrcode.react": "^3.1.0",
    "quill": "^2.0.2",
    "react": "^18.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.70.0",
    "react-quill": "^2.0.0",
    "react-select": "^5.10.2",
    "recharts": "^2.12.2",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.2.2",
    "uiw": "^4.6.13",
    "zod": "^4.6.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^24.1.3",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "turbo": "^2.5.8",
    "typescript": "^5",
    "vitest": "^4.0.16"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "playwright"
  ],
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}