        "status",
        "priority",
        "category",
        "unit"
      ]
    },
    "residents": {
      "columns": [
        "person",
        "unit",
        "role",
        "lease",
        "status",
        "balance"
      ],
      "filters": [
        "role",
        "unit",
        "status"
      ]
    }
  },
